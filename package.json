{
  "name": "zyllen-gestao",
  "version": "0.1.0",
  "private": true,
  "description": "Zyllen Gestão — Sistema de gestão de estoque, patrimônio e chamados",
  "scripts": {
    "dev:api": "pnpm --filter @zyllen/api dev",
    "dev:web": "pnpm --filter @zyllen/web dev",
    "dev": "pnpm run dev:api & pnpm run dev:web",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "check:architecture": "node scripts/quality/check-architecture.cjs",
    "validate:isolated": "node scripts/quality/build-isolated.cjs",
    "test:dashboard": "node scripts/quality/test-ticket-dashboard.cjs",
    "test:maintenance:browser": "node scripts/quality/test-ticket-dashboard.cjs --maintenance",
    "test:tickets:statistics": "node scripts/quality/test-ticket-statistics.cjs",
    "test:projects": "node scripts/quality/test-project-services.cjs",
    "test:projects:browser": "node scripts/quality/test-project-services-browser.cjs",
    "test:projects:agenda:browser": "node scripts/quality/test-ticket-dashboard.cjs --trips --projects-agenda",
    "test:projects:statistics": "node scripts/quality/test-project-statistics.cjs",
    "test:projects:statistics:browser": "node scripts/quality/test-project-statistics-browser.cjs",
    "test:trips": "node scripts/quality/test-trips.cjs",
    "test:trips:browser": "node scripts/quality/test-trips-browser.cjs",
    "test:structures": "node scripts/quality/test-structures.cjs",
    "test:structures:browser": "node scripts/quality/test-ticket-dashboard.cjs --structures --projects-agenda --trips",
    "test:followups:browser": "node scripts/quality/test-ticket-dashboard.cjs --followup-search",
    "test:inventory:custody": "node scripts/quality/test-inventory-custody.cjs",
    "test:inventory:custody:browser": "node scripts/quality/test-inventory-custody-browser.cjs",
    "test:inventory:statistics": "node scripts/quality/test-inventory-statistics.cjs",
    "test:inventory:statistics:browser": "node scripts/quality/test-inventory-statistics-browser.cjs",
    "test:catalog:permissions": "node scripts/quality/test-catalog-permissions.cjs",
    "test:panels:browser": "node scripts/quality/test-personal-panels-browser.cjs",
    "test:panels": "node scripts/quality/test-personal-panels-api.cjs",
    "test:panels:migrations": "node scripts/quality/test-operational-migrations.cjs",
    "test:vehicles": "node scripts/quality/test-vehicles.cjs",
    "db:migrate": "pnpm --filter @zyllen/api prisma:migrate",
    "db:seed": "pnpm --filter @zyllen/api prisma:seed",
    "db:studio": "pnpm --filter @zyllen/api prisma:studio"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
