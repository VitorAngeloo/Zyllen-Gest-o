// ============================================
// Zyllen Gestão — Prisma Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity & Access ────────────────────────

model InternalUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  pin4Hash     String?  @unique
  roleId       String
  sector       String?  // Nome do setor
  description  String?  // Descrição do usuário
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agendaColor         String?  @default("#3B82F6")
  agendaActive        Boolean? @default(false)

  role                Role              @relation(fields: [roleId], references: [id])
  stockMovements      StockMovement[]
  approvalRequests    ApprovalRequest[] @relation("RequestedBy")
  approvedRequests    ApprovalRequest[] @relation("ApprovedBy")
  assignedTickets     Ticket[]
  openedTickets       Ticket[]          @relation("OpenedTickets")
  maintenanceOpened   MaintenanceOS[]   @relation("OpenedBy")
  maintenanceClosed   MaintenanceOS[]   @relation("ClosedBy")
  maintenanceAssigned MaintenanceOS[]   @relation("AssignedTo")
  receivings          Receiving[]
  labelPrintJobs      LabelPrintJob[]
  auditLogs           AuditLog[]
  followupsCreated    Followup[]        @relation("FollowupCreatedBy")
  followupComments    FollowupComment[] @relation("FollowupComments")
  followupHistory     FollowupHistory[] @relation("FollowupHistoryUser")
  ticketRatingsGiven  TicketRating[]    @relation("TicketRatingEvaluator")
  mediaAttachments    ItemMediaAttachment[]
  schedulesCreated    Schedule[]        @relation("ScheduleCreatedBy")
  scheduleInstallations ScheduleInstaller[]
  projectServiceAssignments ProjectServiceInternal[]
  assetEvents         AssetEvent[]
  custodyTransfers    InventoryTransfer[]
  panelMirror         PanelMirror?
  vehicleReservations VehicleReservation[] @relation("VehicleResponsible")
  vehicleBookingsCreated VehicleReservation[] @relation("VehicleBookingCreator")
}

// Carros e reservas têm agenda própria, sem depender de projeto/viagem.
model Vehicle {
  id String @id @default(uuid())
  name String
  plate String? @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reservations VehicleReservation[]
}

model VehicleReservation {
  id String @id @default(uuid())
  vehicleId String
  title String
  responsibleId String
  createdById String
  startDate DateTime
  endDate DateTime
  notes String?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  responsible InternalUser @relation("VehicleResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdBy InternalUser @relation("VehicleBookingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([vehicleId, startDate, endDate])
  @@index([responsibleId])
}

model ExternalUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  cpf          String?  @unique // CPF do usuário externo
  phone        String?  // Telefone
  city         String?  // Cidade
  state        String?  // Estado (UF)
  position     String?  // Cargo/Função
  companyId    String?
  projectId    String?  // Projeto vinculado
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
  tickets  Ticket[]
}

// Solicitação não é identidade autenticável. Só a aprovação cria ExternalUser.
model ClientRegistrationRequest {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  cpf            String?
  phone          String?
  city           String?
  state          String?
  position       String?
  companyId      String?
  projectId      String?
  companyName    String?
  companyCnpj    String?
  status         String   @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  approvedUserId String?
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
}

// Capability opaca: somente o hash é persistido, nunca o token compartilhável.
model MediaShareLink {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  kind         String
  attachmentId String
  createdById  String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([kind, attachmentId])
  @@index([expiresAt])
}


model ContractorUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  cpf          String?  @unique // CPF do terceirizado
  phone        String?  // Telefone
  city         String?  // Cidade
  state        String?  // Estado (UF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  maintenanceOrders MaintenanceOS[] @relation("OpenedByContractor")
  projectServiceAssignments ProjectServiceContractor[]
  tripAssignments TripContractor[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       InternalUser[]
  permissions RolePermission[]
}

model ScreenPermission {
  id     String @id @default(uuid())
  screen String
  action String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([screen, action])
}

model RolePermission {
  id                 String @id @default(uuid())
  roleId             String
  screenPermissionId String

  role             Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  screenPermission ScreenPermission @relation(fields: [screenPermissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, screenPermissionId])
}

// ─── Companies ────────────────────────────────

model Company {
  id      String  @id @default(uuid())
  name    String
  cnpj    String? @unique
  // Campos legados — dados preservados, não usados nos formulários novos
  address String?
  city    String?
  state   String?
  phone   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalUsers     ExternalUser[]
  tickets           Ticket[]
  projects          Project[]
  followups         Followup[]
  schedules         Schedule[]
  maintenanceOrders MaintenanceOS[]
  inventoryLocations Location[]
  operationalStructures OperationalStructure[]
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  phone       String?
  address     String?
  city        String?
  state       String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalUsers     ExternalUser[]
  schedules         Schedule[]
  followups         Followup[]
  maintenanceOrders MaintenanceOS[]
  operationalService ProjectService?
  inventoryLocations Location[]
}

// ─── Catalog & Assets ─────────────────────────

model Category {
  id   String @id @default(uuid())
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skuItems SkuItem[]
}

model SkuItem {
  id           String  @id @default(uuid())
  skuCode      String  @unique
  name         String
  description  String?
  brand        String?
  barcode      String?
  categoryId   String
  codePrefix   String? @unique           // 3-letter prefix for asset codes (e.g. CFP, ATT)
  unit         String? @default("UN")     // UN, M, CX, KG, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category        Category          @relation(fields: [categoryId], references: [id])
  assets          Asset[]
  stockMovements  StockMovement[]
  purchaseItems   PurchaseOrderItem[]
  receivingItems  ReceivingItem[]
  stockMinimums    StockMinimum[]
  mediaAttachments ItemMediaAttachment[]
}

model Asset {
  id                String @id @default(uuid())
  assetCode         String @unique
  skuId             String
  status            String @default("ATIVO")
  currentLocationId String?
  lastExitReason    String?  // motivo da última saída (nulo quando está em estoque)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sku             SkuItem         @relation(fields: [skuId], references: [id])
  currentLocation Location?       @relation(fields: [currentLocationId], references: [id])
  stockMovements  StockMovement[]
  maintenanceOrders MaintenanceOS[]
  labelPrintJobs  LabelPrintJob[]
  events          AssetEvent[]
  transferItems   InventoryTransferItem[]
}

model AssetEvent {
  id                      String   @id @default(uuid())
  assetId                 String
  description             String
  createdByInternalUserId String
  createdAt               DateTime @default(now())

  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy InternalUser @relation(fields: [createdByInternalUserId], references: [id])
}

model AssetCodeSequence {
  id          String   @id
  currentValue Int     @default(0)
  updatedAt   DateTime @updatedAt
}

// ─── Inventory ────────────────────────────────

model Location {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  kind        String? // INTERNAL | CLIENT; null means legacy/unclassified
  companyId   String?
  projectId   String?
  isMainWarehouse Boolean? @unique // true for the selected existing warehouse, null elsewhere
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets            Asset[]
  movementsFrom     StockMovement[] @relation("FromLocation")
  movementsTo       StockMovement[] @relation("ToLocation")
  company           Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transfersFrom     InventoryTransfer[] @relation("TransferFrom")
  transfersTo       InventoryTransfer[] @relation("TransferTo")

  @@index([companyId])
  @@index([projectId])
  stockMinimums     StockMinimum[]
}

// A request UUID identifies an immutable, retry-safe shipment or partial return.
model InventoryTransfer {
  id                  String @id
  kind                String // SHIPMENT | RETURN | INTERNAL
  status              String @default("PENDING") // PENDING | COMPLETED | REJECTED
  fromLocationId      String
  toLocationId        String
  movementTypeId      String
  requestedById       String
  approvalRequestId   String? @unique
  reason              String
  returnStatus        String?
  createdAt           DateTime @default(now())
  completedAt         DateTime?

  fromLocation        Location @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation          Location @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  requestedBy         InternalUser @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  movementType        MovementType @relation(fields: [movementTypeId], references: [id], onDelete: Restrict)
  approvalRequest     ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  items               InventoryTransferItem[]

  @@index([requestedById, createdAt])
  @@index([status])
}

model InventoryTransferItem {
  transferId          String
  assetId             String
  previousStatus      String
  movementId          String? @unique
  transfer            InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  asset               Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  movement            StockMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@id([transferId, assetId])
  @@index([assetId])
}

model StockMinimum {
  id                  String @id @default(uuid())
  skuId               String
  locationId          String
  minimum             Int
  highOutputThreshold Int?
  updatedAt           DateTime @updatedAt
  sku                 SkuItem @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location            Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@unique([skuId, locationId])
  @@index([locationId])
}

model StockMovement {
  id                      String   @id @default(uuid())
  typeId                  String
  skuId                   String
  assetId                 String?
  fromLocationId          String?
  toLocationId            String?
  qty                     Int
  createdByInternalUserId String
  pinValidatedAt          DateTime?
  reason                  String?
  referenceType           String?
  referenceId             String?
  revertedByMovementId    String?
  createdAt               DateTime @default(now())

  type        MovementType  @relation(fields: [typeId], references: [id])
  sku         SkuItem       @relation(fields: [skuId], references: [id])
  asset       Asset?        @relation(fields: [assetId], references: [id])
  fromLocation Location?    @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location?    @relation("ToLocation", fields: [toLocationId], references: [id])
  createdBy   InternalUser  @relation(fields: [createdByInternalUserId], references: [id])
  mediaAttachments ItemMediaAttachment[]

  custodyItem InventoryTransferItem?

  @@index([createdByInternalUserId])
  @@index([skuId])
  @@index([createdAt])
}

model MovementType {
  id                   String  @id @default(uuid())
  name                 String  @unique
  requiresApproval     Boolean @default(false)
  isFinalWriteOff      Boolean @default(false)
  setsAssetStatus      String?
  defaultToLocationId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  stockMovements StockMovement[]
  custodyTransfers InventoryTransfer[]
}

// Motivos de saída configuráveis (por que um item saiu do estoque).
// Separado de MovementType (que é a mecânica: Entrada/Saída/Transferência/Baixa).
model ExitReason {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Approvals ────────────────────────────────

model ApprovalRequest {
  id            String   @id @default(uuid())
  requestType   String
  status        String   @default("PENDING")
  requestedById String
  approvedById  String?
  payloadJson   Json
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requestedBy InternalUser @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedBy  InternalUser? @relation("ApprovedBy", fields: [approvedById], references: [id])
  custodyTransfer InventoryTransfer?
}

// ─── Tickets ──────────────────────────────────

model Ticket {
  id                        String   @id @default(uuid())
  title                     String
  description               String
  companyId                 String?
  externalUserId            String?
  internalUserId            String?
  source                    String   @default("CLIENT") // CLIENT | INTERNAL
  assignedToInternalUserId  String?
  status                    String   @default("OPEN")
  priority                  String   @default("MEDIUM")
  resolutionNotes           String?
  elapsedSeconds            Int?
  slaDueAt                  DateTime?
  firstResponseAt           DateTime?
  closedAt                  DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id])
  externalUser ExternalUser? @relation(fields: [externalUserId], references: [id])
  internalUser InternalUser? @relation("OpenedTickets", fields: [internalUserId], references: [id])
  assignedTo   InternalUser? @relation(fields: [assignedToInternalUserId], references: [id])
  messages     TicketMessage[]
  attachments  TicketAttachment[]
  rating       TicketRating?

  @@index([assignedToInternalUserId])
  @@index([status])
  @@index([companyId])
  @@index([createdAt])
}

model TicketRating {
  id                      String   @id @default(uuid())
  ticketId                String   @unique
  evaluatorInternalUserId String
  rating                  Int
  comment                 String?
  createdAt               DateTime @default(now())

  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  evaluator  InternalUser @relation("TicketRatingEvaluator", fields: [evaluatorInternalUserId], references: [id])
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  authorType String
  content    String
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String
  fileName     String
  filePath     String
  uploadedById String?
  createdAt    DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ─── Maintenance ──────────────────────────────

model MaintenanceOS {
  id                    String    @id @default(uuid())
  osNumber              String    @unique @default(uuid()) // Human-readable OS number
  formType              String    @default("TERCEIRIZADO")  // TERCEIRIZADO | INSTALACAO_SALA | INSTALACAO_TELA | DESINSTALACAO | SUPORTE_REMOTO | MANUTENCAO_TELA_SALA
  assetId               String?   // Optional — some form types don't require an asset
  companyId             String?   // FK to Company — for client portal access
  projectId             String?   // FK to Project — optional, narrows OS to a specific project
  status                String    @default("OPEN")
  openedById            String?   // Internal user who opened
  openedByContractorId  String?   // Contractor who opened
  assignedToId          String?   // Internal user currently responsible (transfer)
  closedById            String?
  notes                 String?
  formData              Json?     // JSON blob with form-specific fields
  clientName            String?   // Client name
  clientCity            String?   // Client city
  clientState           String?   // Client state (UF)
  location              String?   // Maps location / address
  contactName           String?   // Contact person at location
  contactPhone          String?   // Contact phone number
  contactRole           String?   // Contact person's role
  scheduledDate         DateTime? // Scheduled date for the service
  startedAt             DateTime? // When the work actually started
  endedAt               DateTime? // When the work actually ended
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  asset              Asset?          @relation(fields: [assetId], references: [id])
  company            Company?        @relation(fields: [companyId], references: [id])
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  openedBy           InternalUser?   @relation("OpenedBy", fields: [openedById], references: [id])
  openedByContractor ContractorUser? @relation("OpenedByContractor", fields: [openedByContractorId], references: [id])
  assignedTo         InternalUser?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  closedBy           InternalUser?   @relation("ClosedBy", fields: [closedById], references: [id])
  attachments        MaintenanceAttachment[]
  followupBlocks     MaintenanceOSFollowupBlock[]

  @@index([openedById])
  @@index([openedByContractorId])
  @@index([assignedToId])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model MaintenanceAttachment {
  id              String   @id @default(uuid())
  maintenanceOSId String
  fileName        String
  filePath        String
  mimeType        String?
  uploadedById    String?
  createdAt       DateTime @default(now())

  maintenanceOS MaintenanceOS @relation(fields: [maintenanceOSId], references: [id], onDelete: Cascade)
}

model MaintenanceOSFollowupBlock {
  id              String                            @id @default(uuid())
  maintenanceOSId String
  type            String                            // TEXT | MEDIA | SIGNATURE
  content         String?                           // TEXT: text content; SIGNATURE: base64 PNG data URL
  order           Int                               @default(0)
  isLocked        Boolean                           @default(false) // Signature lock — prevents further changes after client confirmation
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  maintenanceOS   MaintenanceOS                     @relation(fields: [maintenanceOSId], references: [id], onDelete: Cascade)
  attachments     MaintenanceOSFollowupAttachment[]

  @@index([maintenanceOSId])
}

model MaintenanceOSFollowupAttachment {
  id        String                     @id @default(uuid())
  blockId   String
  fileName  String
  filePath  String
  mimeType  String?
  createdAt DateTime                   @default(now())
  block     MaintenanceOSFollowupBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
}

// ─── Purchases ────────────────────────────────

model Supplier {
  id      String  @id @default(uuid())
  name    String
  cnpj    String? @unique
  contact String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String   @id @default(uuid())
  supplierId String
  status     String   @default("DRAFT")
  number     String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  items     PurchaseOrderItem[]
  receivings Receiving[]
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  skuId           String
  qtyOrdered      Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku           SkuItem       @relation(fields: [skuId], references: [id])
}

model Receiving {
  id              String   @id @default(uuid())
  purchaseOrderId String
  receivedAt      DateTime @default(now())
  receivedById    String

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    InternalUser   @relation(fields: [receivedById], references: [id])
  items         ReceivingItem[]
}

model ReceivingItem {
  id             String  @id @default(uuid())
  receivingId    String
  skuId          String
  qtyReceived    Int
  divergenceNote String?

  receiving Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  sku       SkuItem   @relation(fields: [skuId], references: [id])
}

// ─── Labels ───────────────────────────────────

model LabelTemplate {
  id     String @id @default(uuid())
  name   String @unique
  layout Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabelPrintJob {
  id          String   @id @default(uuid())
  assetId     String
  printedById String
  printedAt   DateTime @default(now())

  asset     Asset        @relation(fields: [assetId], references: [id])
  printedBy InternalUser @relation(fields: [printedById], references: [id])
}

// ─── Audit ────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  userId     String
  details    Json?
  createdAt  DateTime @default(now())

  user InternalUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Followups (Acompanhamento) ───────────────

model Followup {
  id                String   @id @default(uuid())
  code              String   @unique
  companyId         String
  projectId         String?  // FK to Project — optional, narrows the followup to a specific project
  createdById       String
  responsibleName   String?  // Nome do responsável do cliente
  responsibleContact String? // Contato do responsável
  status            String   @default("IN_PROGRESS") // IN_PROGRESS | PENDING | COMPLETED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy InternalUser @relation("FollowupCreatedBy", fields: [createdById], references: [id])
  blocks    FollowupBlock[]
  history   FollowupHistory[]

  @@index([projectId])
}

model FollowupBlock {
  id         String   @id @default(uuid())
  followupId String
  type       String   // TEXT | MEDIA | CHECKLIST
  title      String?
  content    String?  // Texto para blocos TEXT
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  followup       Followup                 @relation(fields: [followupId], references: [id], onDelete: Cascade)
  attachments    FollowupBlockAttachment[]
  comments       FollowupComment[]
  checklistItems FollowupChecklistItem[]
}

model FollowupChecklistItem {
  id        String   @id @default(uuid())
  blockId   String
  text      String
  details   String?
  checked   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  block FollowupBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model FollowupBlockAttachment {
  id           String   @id @default(uuid())
  blockId      String
  fileName     String
  filePath     String
  mimeType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  block FollowupBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model FollowupComment {
  id        String   @id @default(uuid())
  blockId   String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  block  FollowupBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  author InternalUser  @relation("FollowupComments", fields: [authorId], references: [id])
}

model FollowupHistory {
  id         String   @id @default(uuid())
  followupId String
  userId     String
  action     String
  details    Json?
  createdAt  DateTime @default(now())

  followup Followup     @relation(fields: [followupId], references: [id], onDelete: Cascade)
  user     InternalUser @relation("FollowupHistoryUser", fields: [userId], references: [id])
}

model ItemMediaAttachment {
  id              String   @id @default(uuid())
  skuId           String?
  stockMovementId String?
  fileName        String
  filePath        String
  mimeType        String
  mediaType       String   // IMAGE | VIDEO
  uploadedById    String
  createdAt       DateTime @default(now())

  sku           SkuItem?       @relation(fields: [skuId], references: [id], onDelete: SetNull)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)
  uploadedBy    InternalUser   @relation(fields: [uploadedById], references: [id])

  @@index([skuId])
  @@index([stockMovementId])
  @@index([uploadedById])
}

// ─── Agenda Operacional ───────────────────────

model Schedule {
  id               String   @id @default(uuid())
  title            String
  type             String   @default("INSTALLATION") // INSTALLATION | MAINTENANCE | REMOVAL | SUPPORT | OTHER
  status           String   @default("SCHEDULED")    // SCHEDULED | IN_PROGRESS | DONE | CANCELLED
  startDate        DateTime
  endDate          DateTime
  address          String?
  notes            String?
  companyId        String?
  projectId        String?
  parentScheduleId String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  company        Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentSchedule Schedule?          @relation("ScheduleChildren", fields: [parentScheduleId], references: [id], onDelete: SetNull)
  childSchedules Schedule[]         @relation("ScheduleChildren")
  createdBy      InternalUser       @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  installers     ScheduleInstaller[]
  recurrence     ScheduleRecurrence?
  projectService ProjectService?
  trip           Trip?

  @@index([startDate, endDate])
  @@index([status])
  @@index([companyId])
  @@index([createdById])
}

// One operational service per client project; legacy projects remain outside this management.
model ProjectService {
  id             String @id @default(uuid())
  projectId      String @unique
  scheduleId     String? @unique
  markerId       String?
  tripId         String?
  removalCycleId String?
  type           String // INSTALLATION | REMOVAL
  urgency        Int @default(0) // 0 normal | 1 high | 2 urgent
  color          String @default("#ABFF10")
  mapsUrl        String?
  notes          String?
  sectors        String[] @default([])
  requiresTravel Boolean @default(false)
  relevant       Boolean @default(false)
  cancelledAt    DateTime? // Cancellation before scheduling only.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  schedule    Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  marker      ProjectServiceMarker? @relation(fields: [markerId], references: [id], onDelete: Restrict)
  trip        Trip? @relation(fields: [tripId], references: [id], onDelete: Restrict)
  internalAssignees ProjectServiceInternal[]
  contractors ProjectServiceContractor[]
  installationCycle StructureCycle? @relation("CycleInstallation")
  removalCycle StructureCycle? @relation("CycleRemovals", fields: [removalCycleId], references: [id], onDelete: Restrict)
  @@index([urgency, createdAt])
  @@index([tripId])
  @@index([removalCycleId])
}

// Persistent identity within the operational domain; no automatic asset/stock links.
model OperationalStructure {
  id String @id @default(uuid())
  companyId String
  name String
  nameKey String
  kind String // ROOM | TOTEM | OTHER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cycles StructureCycle[]
  @@unique([companyId, nameKey])
}

// A revocable bearer link restricted to selected read-only dashboards, never an account token.
model PanelMirror {
  id String @id @default(uuid())
  ownerId String @unique
  tokenHash String @unique
  views String[]
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner InternalUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

// Cancelled removal attempts remain attached; a later attempt is a separate project/service.
model StructureCycle {
  id String @id @default(uuid())
  structureId String
  installationId String @unique
  createdAt DateTime @default(now())
  structure OperationalStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)
  installation ProjectService @relation("CycleInstallation", fields: [installationId], references: [id], onDelete: Restrict)
  removals ProjectService[] @relation("CycleRemovals")
  @@index([structureId, createdAt])
}

// A shared displacement; dates/status/actual events remain canonical in Schedule.
model Trip {
  id               String @id @default(uuid())
  scheduleId       String @unique
  originCity       String
  originState      String
  destinationCity  String
  destinationState String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  schedule         Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  services         ProjectService[]
  contractors      TripContractor[]
}

model TripContractor {
  tripId String
  userId String
  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   ContractorUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([tripId, userId])
  @@index([userId])
}

model ProjectServiceMarker {
  id        String @id @default(uuid())
  name      String
  nameKey   String @unique
  createdAt DateTime @default(now())
  services  ProjectService[]
}

model ProjectServiceInternal {
  serviceId String
  userId    String
  service ProjectService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user InternalUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([serviceId, userId])
  @@index([userId])
}

model ProjectServiceContractor {
  serviceId String
  userId    String
  service ProjectService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user ContractorUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([serviceId, userId])
  @@index([userId])
}

model ScheduleInstaller {
  id          String   @id @default(uuid())
  scheduleId  String
  installerId String
  createdAt   DateTime @default(now())

  schedule  Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  installer InternalUser @relation(fields: [installerId], references: [id])

  @@unique([scheduleId, installerId])
  @@index([installerId])
}

model ScheduleRecurrence {
  id         String    @id @default(uuid())
  scheduleId String    @unique
  type       String    // DAILY | WEEKLY | MONTHLY
  interval   Int       @default(1)
  daysOfWeek String?   // JSON array: "[1,3,5]"
  endDate    DateTime?
  count      Int?
  createdAt  DateTime  @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}
